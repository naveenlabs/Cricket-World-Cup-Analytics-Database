<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= queryTitle %> - Analytics Hub
    </title>
    <link rel="stylesheet" href="../style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

    <div class="content-wrapper">
        <header style="margin-bottom: 20px;">
            <h1>World Cup Cricket Analytics Hub</h1>
        </header>

        <div class="results-header-bar">
            <a href="../" class="back-button">
                <i class="fa-solid fa-arrow-left-long"></i> Back to Queries
            </a>
            <div class="header-text">
                <h2 class="results-title">
                    <%= queryTitle %>
                </h2>
                <p class="full-question">
                    <%= fullQuestion %>
                </p>
            </div>
        </div>

        <% if (locals.analystTake) { %>
            <div class="analyst-card">
                <div class="analyst-header">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Analyst's Take
                </div>
                <p class="analyst-text">
                    <%= analystTake %>
                </p>
            </div>
            <% } %>

                <div class="chart-section-card">
                    <h3 class="chart-heading">Strike Rate Visual Analysis</h3>

                    <div class="format-toggle-container">
                        <div class="toggle-label active" id="label-odi">[ 🏏 ODI World Cup ]</div>
                        <label class="switch">
                            <input type="checkbox" id="formatToggle">
                            <span class="slider round"></span>
                        </label>
                        <div class="toggle-label" id="label-t20">[ ⚡ T20 World Cup ]</div>
                    </div>

                    <div class="canvas-container">
                        <canvas id="q3Chart"></canvas>
                    </div>
                </div>

                <main class="results-card" style="overflow: visible;">
                    <div class="table-responsive">
                        <table class="results-table">
                            <thead>
                                <tr>
                                    <th style="width:50px;">#</th>
                                    <% fields.forEach(field=> { %>
                                        <th>
                                            <%= field.name.replace(/_/g,' ') %></th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
        </main>
    </div>

    <script id="data-results" type="application/json"><%- JSON.stringify(results || []) %></script>
    <script id="data-fields" type="application/json"><%- JSON.stringify(fields || []) %></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            console.log("✅ Q3 View Loaded Successfully");

            const rawResults =
                JSON.parse(document.getElementById('data-results').textContent);
            const tableFields =
                JSON.parse(document.getElementById('data-fields').textContent);

            const toggle = document.getElementById('formatToggle');
            const tbody = document.getElementById('tableBody');
            const labelOdi = document.getElementById('label-odi');
            const labelT20 = document.getElementById('label-t20');

            let chartInstance = null;

            function updateView() {
                const isT20 = toggle.checked;
                const format = isT20 ? 'T20' : 'ODI';

                // Update UI Labels
                if (isT20) {
                    labelOdi.classList.remove('active');
                    labelT20.classList.add('active');
                } else {
                    labelOdi.classList.add('active');
                    labelT20.classList.remove('active');
                }

                // 1. RENDER TABLE
                tbody.innerHTML = '';
                const tableData = rawResults.filter(r => (r.format_name || '').trim()
                    === format);

                tableData.forEach((row, index) => {
                    const tr = document.createElement('tr');
                    tr.className = 'data-row';

                    // FIXED: Standard rank circle for all rows (no gold/silver/bronze)
                    let rowHtml = `
                                        <td>
                                            <div class="rank-circle">${index + 1}</div>
                                        </td>`;

                    tableFields.forEach(field => {
                        let val = row[field.name];

                        // RESTORED: Format Badge logic for ODI and T20
                        if (field.name === 'format_name') {
                            const badgeClass = val === 'ODI' ? 'format-odi' : 'format-t20';
                            val = `<span class="format-badge ${badgeClass}">${val}</span>`;
                        }
                        // Round decimals if numeric
                        else if (!isNaN(val) && val !== null && val !== '' && val % 1 !== 0) {
                            val = Number(val).toFixed(2);
                        }
                        rowHtml += `<td>${val}</td>`;
                    });
                    tr.innerHTML = rowHtml;
                    tbody.appendChild(tr);
                });

                // 2. RENDER CHART
                const ctx = document.getElementById('q3Chart').getContext('2d');
                if (chartInstance) chartInstance.destroy();

                const phases = ['Powerplay', 'Middle Overs', 'Death Overs'];
                const topOrder = [null, null, null];
                const middleOrder = [null, null, null];

                tableData.forEach(row => {
                    const pIndex = phases.indexOf(row.match_phase);
                    const role = (row.batting_role || '').trim();
                    if (pIndex > -1) {
                        if (role === 'Top Order') topOrder[pIndex] = row.strike_rate;
                        if (role === 'Middle Order') middleOrder[pIndex] = row.strike_rate;
                    }
                });

                chartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: phases,
                        datasets: [
                            {
                                label: 'Top Order',
                                data: topOrder,
                                borderColor: '#00e5ff',
                                backgroundColor: 'rgba(0,229,255,0.1)',
                                borderWidth: 3,
                                tension: 0.3,
                                fill: true,
                                pointRadius: 5
                            },
                            {
                                label: 'Middle Order',
                                data: middleOrder,
                                borderColor: '#d946ef',
                                backgroundColor: 'rgba(217,70,239,0.1)',
                                borderWidth: 3,
                                tension: 0.3,
                                fill: true,
                                pointRadius: 5
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 800, easing: 'easeOutQuart' },
                        plugins: {
                            legend: { display: true, labels: { color: '#cbd5e1' } },
                            tooltip: { backgroundColor: 'rgba(15,23,42,0.95)', titleColor: '#fff' }
                        },
                        scales: {
                            y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                            x: { ticks: { color: '#fff' }, grid: { display: false } }
                        }
                    }
                });
            }

            toggle.addEventListener('change', updateView);
            updateView();
        });
    </script>
</body>

</html>
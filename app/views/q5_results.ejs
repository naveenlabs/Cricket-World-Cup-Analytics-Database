<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= queryTitle %> - Analytics Hub</title>
    <link rel="stylesheet" href="../style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* ===============================
           PHASE BUTTONS – RED THEME
           =============================== */
        .btn-phase {
            position: relative;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #94a3b8;
            padding: 10px 22px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            transition: all 0.25s ease;
        }

        .btn-phase:hover {
            color: #ffffff;
            border-color: #ff4d4d;
            background: rgba(255, 77, 77, 0.05);
            transform: translateY(-1px);
        }

        /* Red Identity for Active Phase */
        .btn-phase.active {
            color: #ff4d4d;
            border-color: #ff4d4d;
            background: rgba(255, 77, 77, 0.15);
            box-shadow: 0 0 18px rgba(255, 77, 77, 0.4), inset 0 0 10px rgba(255, 77, 77, 0.1);
        }

        .btn-phase.active::after {
            content: "";
            position: absolute;
            bottom: -6px;
            left: 50%;
            transform: translateX(-50%);
            width: 60%;
            height: 2px;
            background: #ff4d4d;
            border-radius: 2px;
            opacity: 0.8;
        }
    </style>
</head>

<body>
    <div class="content-wrapper">
        <header style="margin-bottom: 20px;">
            <h1>World Cup Cricket Analytics Hub</h1>
        </header>

        <div class="results-header-bar">
            <a href="../" class="back-button">
                <i class="fa-solid fa-arrow-left-long"></i> Back to Queries
            </a>
            <div class="header-text">
                <h2 class="results-title"><%= queryTitle %></h2>
                <p class="full-question"><%= fullQuestion %></p>
            </div>
        </div>

        <% if (locals.analystTake) { %>
            <div class="analyst-card">
                <div class="analyst-header">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Analyst's Take
                </div>
                <p class="analyst-text"><%= analystTake %></p>
            </div>
        <% } %>

        <div class="chart-section-card">
            <h3 class="chart-heading">Bowling Efficiency (Balls Per Wicket)</h3>

            <div class="filter-row" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;margin-bottom:20px;">
                <div class="format-toggle-container">
                    <div class="toggle-label active" id="label-odi">[ 🏏 ODI ]</div>
                    <label class="switch">
                        <input type="checkbox" id="formatToggle">
                        <span class="slider round"></span>
                    </label>
                    <div class="toggle-label" id="label-t20">[ ⚡ T20 ]</div>
                </div>

                <div class="phase-selector" style="display:flex;gap:14px;">
                    <button class="btn-phase active" data-phase="Powerplay">Powerplay</button>
                    <button class="btn-phase" data-phase="Death Overs">Death Overs</button>
                </div>
            </div>

            <div class="canvas-container" style="height:500px;">
                <canvas id="q5Chart"></canvas>
            </div>
        </div>

        <main class="results-card" style="overflow:visible;">
            <div class="table-responsive">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <% fields.forEach(field => { %>
                                <th><%= field.name.replace(/_/g,' ') %></th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
        </main>
    </div>

    <script id="data-results" type="application/json"><%- JSON.stringify(results || []) %></script>
    <script id="data-fields" type="application/json"><%- JSON.stringify(fields || []) %></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const rawResults = JSON.parse(document.getElementById('data-results').textContent);
            const tableFields = JSON.parse(document.getElementById('data-fields').textContent);

            const formatToggle = document.getElementById('formatToggle');
            const phaseButtons = document.querySelectorAll('.btn-phase');
            const tbody = document.getElementById('tableBody');
            const labelOdi = document.getElementById('label-odi');
            const labelT20 = document.getElementById('label-t20');

            let currentPhase = 'Powerplay';
            let chartInstance = null;

            function updateView() {
                const isT20 = formatToggle.checked;
                const format = isT20 ? 'T20' : 'ODI';

                labelOdi.classList.toggle('active', !isT20);
                labelT20.classList.toggle('active', isT20);

                const filteredData = rawResults.filter(r =>
                    (r.format_name || '').trim() === format &&
                    (r.match_phase || '').trim() === currentPhase
                );

                /* TABLE */
                tbody.innerHTML = '';
                filteredData.forEach((row, i) => {
                    const tr = document.createElement('tr');
                    let rank = `<div class="rank-circle">${i + 1}</div>`;
                    if (i === 0) rank = `<div class="rank-circle rank-1">${i + 1}</div>`;
                    if (i === 1) rank = `<div class="rank-circle rank-2">${i + 1}</div>`;
                    if (i === 2) rank = `<div class="rank-circle rank-3">${i + 1}</div>`;

                    let html = `<td>${rank}</td>`;
                    tableFields.forEach(f => {
                        let v = row[f.name];
                        if (f.name === 'format_name') {
                            v = `<span class="format-badge ${v === 'ODI' ? 'format-odi' : 'format-t20'}">${v}</span>`;
                        } else if (!isNaN(v) && v !== null && v !== '' && v % 1 !== 0) {
                            v = Number(v).toFixed(2);
                        }
                        html += `<td>${v ?? 0}</td>`;
                    });
                    tr.innerHTML = html;
                    tbody.appendChild(tr);
                });

                /* CHART */
                const ctx = document.getElementById('q5Chart').getContext('2d');
                if (chartInstance) chartInstance.destroy();

                const labels = filteredData.map(r => r.bowler_name);
                const values = filteredData.map(r => Number(r.balls_per_wicket) || 0);

                // EXACT Q1 COLORS
                const glowColor = isT20 ? '#00f2ff' : '#d946ef';
                const fillStart = isT20 ? 'rgba(0,242,255,0)' : 'rgba(217,70,239,0)';
                const fillEnd = isT20 ? 'rgba(0,242,255,0.85)' : 'rgba(217,70,239,0.85)';

                // Horizontal Gradient matching Q1 logic
                const gradient = ctx.createLinearGradient(0, 0, 800, 0);
                gradient.addColorStop(0, fillStart);
                gradient.addColorStop(1, fillEnd);

                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [{
                            data: values,
                            backgroundColor: gradient,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 1000, easing: 'easeOutQuart' },
                        plugins: { legend: { display: false } },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: { color: '#94a3b8' },
                                grid: { color: 'rgba(255,255,255,0.05)' },
                                title: { display: true, text: 'Lower is Better (Efficiency)', color: '#94a3b8' }
                            },
                            y: {
                                ticks: { color: '#fff', font: { weight: 'bold' } },
                                grid: { display: false }
                            }
                        }
                    },
                    plugins: [{
                        id: 'neonGlow',
                        beforeDraw(c) {
                            c.ctx.save();
                            c.ctx.shadowBlur = 20;
                            c.ctx.shadowColor = glowColor;
                            c.ctx.shadowOffsetX = 5;
                        },
                        afterDraw(c) { c.ctx.restore(); }
                    }]
                });
            }

            phaseButtons.forEach(b => {
                b.addEventListener('click', () => {
                    phaseButtons.forEach(x => x.classList.remove('active'));
                    b.classList.add('active');
                    currentPhase = b.dataset.phase;
                    updateView();
                });
            });

            formatToggle.addEventListener('change', updateView);
            updateView();
        });
    </script>
</body>
</html>
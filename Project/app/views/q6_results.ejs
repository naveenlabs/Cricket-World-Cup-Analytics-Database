<%# 
    VIEW TEMPLATE: q6_results.ejs 
    -----------------------------------------------------------------------------
    Description: Dismissal Type Distribution Analysis.
    Features: 
    - Stacked Bar Chart showing percentage share of dismissal types.
    - Format-specific data filtering (ODI/T20).
    - Dynamic color mapping for different dismissal categories (Caught, Bowled, etc.).
    - Percentage-based Y-axis scaling.
    -----------------------------------------------------------------------------
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= queryTitle %> - Analytics Hub</title>
    
    <link rel="stylesheet" href="../style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <div class="content-wrapper">
        <header style="margin-bottom: 20px;">
            <h1>World Cup Cricket Analytics Hub</h1>
        </header>

        <div class="results-header-bar">
            <a href="../" class="back-button">
                <i class="fa-solid fa-arrow-left-long"></i> Back to Queries
            </a>
            <div class="header-text">
                <h2 class="results-title"><%= queryTitle %></h2>
                <p class="full-question"><%= fullQuestion %></p>
            </div>
        </div>

        <% if (locals.analystTake) { %>
            <div class="analyst-card">
                <div class="analyst-header">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Analyst's Take
                </div>
                <p class="analyst-text"><%= analystTake %></p>
            </div>
        <% } %>

        <div class="chart-section-card">
            <h3 class="chart-heading">Dismissal Type Distribution by Phase</h3>

            <div class="format-toggle-container" style="margin-bottom: 20px;">
                <div class="toggle-label active" id="label-odi">[ 🏏 ODI World Cup ]</div>
                <label class="switch">
                    <input type="checkbox" id="formatToggle">
                    <span class="slider round"></span>
                </label>
                <div class="toggle-label" id="label-t20">[ ⚡ T20 World Cup ]</div>
            </div>

            <div class="canvas-container" style="height: 450px;">
                <canvas id="q6Chart"></canvas>
            </div>
        </div>

        <main class="results-card" style="overflow: visible;">
            <div class="table-responsive">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <% fields.forEach(field => { %>
                                <th><%= field.name.replace(/_/g,' ') %></th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
        </main>
    </div>

    <script id="data-results" type="application/json"><%- JSON.stringify(results || []) %></script>
    <script id="data-fields" type="application/json"><%- JSON.stringify(fields || []) %></script>

    <script>
        /**
         * FRONT-END CONTROLLER: Q6 Dismissal Analysis
         * Handles the complex transformation of row-based SQL data into stacked datasets.
         */
        document.addEventListener('DOMContentLoaded', () => {
            const rawResults = JSON.parse(document.getElementById('data-results').textContent);
            const tableFields = JSON.parse(document.getElementById('data-fields').textContent);

            const toggle = document.getElementById('formatToggle');
            const tbody = document.getElementById('tableBody');
            const labelOdi = document.getElementById('label-odi');
            const labelT20 = document.getElementById('label-t20');

            let chartInstance = null;

            // Define consistent branding colors for each dismissal mechanism
            const colorMap = {
                'caught': '#00f2ff', 
                'bowled': '#d946ef', 
                'lbw': '#fbbf24', 
                'run out': '#ef4444', 
                'stumped': '#10b981', 
                'caught and bowled': '#6366f1', 
                'retired hurt': '#94a3b8', 
                'hit wicket': '#f97316'
            };

            /**
             * Primary function to update UI elements based on format selection
             */
            function updateView() {
                const isT20 = toggle.checked;
                const format = isT20 ? 'T20' : 'ODI';

                // Sync Labels
                labelOdi.classList.toggle('active', !isT20);
                labelT20.classList.toggle('active', isT20);

                // Filter data for the table and chart
                const formatData = rawResults.filter(r => (r.format_name || '').trim() === format);

                // --- TABLE RENDERING ---
                tbody.innerHTML = '';
                formatData.forEach((row, index) => {
                    const tr = document.createElement('tr');
                    tr.className = 'data-row';

                    let rowHtml = `<td><div class="rank-circle">${index + 1}</div></td>`;
                    tableFields.forEach(field => {
                        let val = row[field.name];
                        if (field.name === 'format_name') {
                            val = `<span class="format-badge ${val === 'ODI' ? 'format-odi' : 'format-t20'}">${val}</span>`;
                        } else if (!isNaN(val) && val !== null && val !== '' && val % 1 !== 0) {
                            val = Number(val).toFixed(2);
                        }
                        rowHtml += `<td>${val || '0'}</td>`;
                    });
                    tr.innerHTML = rowHtml;
                    tbody.appendChild(tr);
                });

                // --- CHART DATA TRANSFORMATION ---
                const ctx = document.getElementById('q6Chart').getContext('2d');
                if (chartInstance) chartInstance.destroy();

                const phases = ['Powerplay', 'Middle Overs', 'Death Overs'];
                const dismissalTypes = [...new Set(formatData.map(r => r.dismissal_type))];

                // Create a dataset for each dismissal type to enable stacking
                const datasets = dismissalTypes.map(type => {
                    return {
                        label: type.charAt(0).toUpperCase() + type.slice(1),
                        data: phases.map(phase => {
                            const entry = formatData.find(r => r.match_phase === phase && r.dismissal_type === type);
                            return entry ? Number(entry.percentage_share) : 0;
                        }),
                        backgroundColor: colorMap[type] || '#ffffff',
                        borderWidth: 0,
                        borderRadius: 4
                    };
                });

                // --- CHART INITIALIZATION ---
                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: { labels: phases, datasets: datasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 1000, easing: 'easeOutQuart' },
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: { color: '#cbd5e1', font: { size: 11 } }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(15,23,42,0.95)',
                                callbacks: {
                                    label: (ctx) => `${ctx.dataset.label}: ${ctx.raw.toFixed(2)}%`
                                }
                            }
                        },
                        scales: {
                            x: {
                                stacked: true,
                                ticks: { color: '#fff', font: { weight: 'bold' } },
                                grid: { display: false }
                            },
                            y: {
                                stacked: true, 
                                beginAtZero: true,
                                max: 100,
                                ticks: { color: '#94a3b8', callback: v => v + '%' },
                                grid: { color: 'rgba(255,255,255,0.05)' }
                            }
                        }
                    }
                });
            }

            // --- EVENT LISTENERS ---
            toggle.addEventListener('change', updateView);
            updateView();
        });
    </script>
</body>
</html>
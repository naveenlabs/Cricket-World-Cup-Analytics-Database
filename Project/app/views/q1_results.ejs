<%# 
    VIEW TEMPLATE: q1_results.ejs 
    -----------------------------------------------------------------------------
    Description: Detailed analysis view for Question 1.
    Features: Dynamic data table, format switching (ODI/T20), and 
    interactive Chart.js bar visualization with custom neon effects.
    -----------------------------------------------------------------------------
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= queryTitle %> - Analytics Hub</title>

    <link rel="stylesheet" href="../style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <div class="content-wrapper">
        <header style="margin-bottom: 20px;">
            <h1>World Cup Cricket Analytics Hub</h1>
        </header>

        <div class="results-header-bar">
            <a href="../" class="back-button">
                <i class="fa-solid fa-arrow-left-long"></i> Back to Queries
            </a>
            <div class="header-text">
                <h2 class="results-title"><%= queryTitle %></h2>
                <p class="full-question"><%= fullQuestion %></p>
            </div>
        </div>

        <% if (locals.analystTake) { %>
            <div class="analyst-card">
                <div class="analyst-header">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Analyst's Take
                </div>
                <p class="analyst-text"><%= analystTake %></p>
            </div>
        <% } %>

        <div class="chart-section-card">
            <h3 class="chart-heading">Weighted Impact Score Analysis</h3>

            <div class="format-toggle-container">
                <div class="toggle-label active" id="label-odi">[ 🏏 ODI World Cup ]</div>
                <label class="switch">
                    <input type="checkbox" id="formatToggle">
                    <span class="slider round"></span>
                </label>
                <div class="toggle-label" id="label-t20">[ ⚡ T20 World Cup ]</div>
            </div>

            <div class="canvas-container">
                <canvas id="q1Chart"></canvas>
            </div>
        </div>

        <main class="results-card" style="overflow: visible;">
            <div class="table-responsive">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <% fields.forEach(field => { %>
                                <th><%= field.name.replace(/_/g,' ') %></th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
        </main>
    </div>

    <script id="data-results" type="application/json"><%- JSON.stringify(results || []) %></script>
    <script id="data-fields" type="application/json"><%- JSON.stringify(fields || []) %></script>

    <script>
        /**
         * FRONT-END LOGIC
         * Handles data filtering, table rendering, and chart initialization.
         */
        document.addEventListener('DOMContentLoaded', () => {
            console.log("✅ Q1 Standalone View Initialized");

            // --- DATA PARSING ---
            const rawResults = JSON.parse(document.getElementById('data-results').textContent);
            const tableFields = JSON.parse(document.getElementById('data-fields').textContent);

            // --- UI ELEMENTS ---
            const toggle = document.getElementById('formatToggle');
            const tbody = document.getElementById('tableBody');
            const labelOdi = document.getElementById('label-odi');
            const labelT20 = document.getElementById('label-t20');

            let chartInstance = null;

            /**
             * Renders the UI based on the current toggle state (ODI vs T20)
             */
            function updateView() {
                const isT20 = toggle.checked;
                const format = isT20 ? 'T20' : 'ODI';

                // Update label styling
                if (isT20) {
                    labelOdi.classList.remove('active');
                    labelT20.classList.add('active');
                } else {
                    labelOdi.classList.add('active');
                    labelT20.classList.remove('active');
                }

                // --- TABLE RENDERING ---
                tbody.innerHTML = '';
                const tableData = rawResults.filter(r => (r.format_name || '').trim() === format);

                tableData.forEach((row, index) => {
                    const tr = document.createElement('tr');
                    tr.className = 'data-row';

                    // Rank Circle Logic
                    let rankHtml = `<div class="rank-circle">${index + 1}</div>`;
                    if (index === 0) rankHtml = `<div class="rank-circle rank-1">${index + 1}</div>`;
                    if (index === 1) rankHtml = `<div class="rank-circle rank-2">${index + 1}</div>`;
                    if (index === 2) rankHtml = `<div class="rank-circle rank-3">${index + 1}</div>`;

                    let rowHtml = `<td>${rankHtml}</td>`;

                    // Dynamic Cell Rendering
                    tableFields.forEach(field => {
                        let val = row[field.name];
                        if (field.name === 'format_name') {
                            val = `<span class="format-badge ${val === 'ODI' ? 'format-odi' : 'format-t20'}">${val}</span>`;
                        } else if (!isNaN(val) && val !== null && val !== '' && val % 1 !== 0) {
                            val = Number(val).toFixed(2);
                        }
                        rowHtml += `<td>${val}</td>`;
                    });
                    tr.innerHTML = rowHtml;
                    tbody.appendChild(tr);
                });

                // --- CHART RENDERING ---
                const ctx = document.getElementById('q1Chart').getContext('2d');
                if (chartInstance) chartInstance.destroy();

                const chartLabels = tableData.map(r => r.player_name);
                const chartValues = tableData.map(r => r.weighted_impact_score);

                // Dynamic visual configuration based on format
                const glowColor = isT20 ? '#00f2ff' : '#d946ef';
                const fillStart = isT20 ? 'rgba(0,242,255,0.85)' : 'rgba(217,70,239,0.85)';
                const fillEnd = isT20 ? 'rgba(0,242,255,0)' : 'rgba(217,70,239,0)';

                const gradient = ctx.createLinearGradient(0, 0, 0, 400);
                gradient.addColorStop(0, fillStart);
                gradient.addColorStop(1, fillEnd);

                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: chartLabels,
                        datasets: [{
                            label: 'Weighted Impact Score',
                            data: chartValues,
                            backgroundColor: gradient,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 1000,
                            easing: 'easeOutQuart'
                        },
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { color: '#94a3b8' },
                                grid: { color: 'rgba(255,255,255,0.05)' }
                            },
                            x: { ticks: { color: '#fff' }, grid: { display: false } }
                        }
                    },
                    plugins: [{
                        id: 'neonGlow',
                        beforeDraw(c) {
                            c.ctx.save();
                            c.ctx.shadowBlur = 15;
                            c.ctx.shadowColor = glowColor;
                        },
                        afterDraw(c) { c.ctx.restore(); }
                    }]
                });
            }

            // --- EVENT LISTENERS ---
            toggle.addEventListener('change', updateView);
            updateView();
        });
    </script>
</body>

</html>
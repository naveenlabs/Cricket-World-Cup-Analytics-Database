<%# 
    VIEW TEMPLATE: q10_results.ejs 
    -----------------------------------------------------------------------------
    Description: Venue Scoring Patterns (The Bias Matrix).
    Features: 
    - Bubble Chart comparing 1st vs 2nd Innings scores with color-coded bias.
    - Custom Parity Line Plugin (Diagonal line showing score equality).
    - Client-side pagination for the venue data table (15 rows per page).
    - Smooth scroll integration for pagination navigation.
    -----------------------------------------------------------------------------
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= queryTitle %></title>
    
    <link rel="stylesheet" href="../style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .pagination-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .page-btn {
            background: rgba(0, 242, 255, 0.1);
            border: 1px solid #00f2ff;
            color: #00f2ff;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .page-btn:hover:not(:disabled) {
            background: #00f2ff;
            color: #000;
        }

        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            border-color: #94a3b8;
            color: #94a3b8;
            background: transparent;
        }

        .page-info {
            color: #e2e8f0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <div class="content-wrapper">
        <header style="margin-bottom: 20px;">
            <h1>World Cup Cricket Analytics Hub</h1>
        </header>

        <div class="results-header-bar">
            <a href="../" class="back-button"><i class="fa-solid fa-arrow-left-long"></i> Back to Queries</a>
            <div class="header-text">
                <h2 class="results-title"><%= queryTitle %></h2>
                <p class="full-question"><%= fullQuestion %></p>
            </div>
        </div>

        <% if (locals.analystTake) { %>
            <div class="analyst-card">
                <div class="analyst-header">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Analyst's Take
                </div>
                <p class="analyst-text"><%= analystTake %></p>
            </div>
        <% } %>

        <div class="chart-section-card">
            <h3 class="chart-heading">VENUE BIAS MATRIX: DEFEND VS CHASE</h3>
            <p style="color: #94a3b8; font-size: 0.9rem; text-align:center; margin-bottom: 20px;">
                <span style="color:#ff3366">● Defender's Fortress</span> |
                <span style="color:#00f2ff">● Balanced</span> |
                <span style="color:#39ff14">● Chaser's Paradise</span>
            </p>

            <div class="format-toggle-container">
                <div class="toggle-label active" id="label-odi">[ 🏏 ODI World Cup ]</div>
                <label class="switch">
                    <input type="checkbox" id="formatToggle">
                    <span class="slider round"></span>
                </label>
                <div class="toggle-label" id="label-t20">[ ⚡ T20 World Cup ]</div>
            </div>

            <div class="canvas-container"
                style="height: 600px; background: radial-gradient(circle at center, rgba(30,41,59,0.8) 0%, rgba(15,23,42,0.95) 100%); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 20px;">
                <canvas id="q10Chart"></canvas>
            </div>
        </div>

        <main class="results-card" style="margin-top: 30px;">
            <div class="table-responsive">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th style="width:50px;">Rank</th>
                            <th>Format</th>
                            <th>Venue Name</th>
                            <th>Country</th>
                            <th>Matches</th>
                            <th>Avg 1st Innings</th>
                            <th>Avg 2nd Innings</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>

            <div class="pagination-container" id="paginationControls">
                <button class="page-btn" id="prevBtn" onclick="changePage(-1)">Previous</button>
                <span class="page-info" id="pageInfo">Page 1 of 1</span>
                <button class="page-btn" id="nextBtn" onclick="changePage(1)">Next</button>
            </div>
        </main>
    </div>

    <script id="data-payload" type="application/json"><%- JSON.stringify(results || []) %></script>
    
    <script>
        /**
         * FRONT-END CONTROLLER: Q10 Venue Bias Analysis
         * Handles dynamic filtering, pagination, and specialized bubble chart rendering.
         */
        let rawData = [];
        let filteredData = [];
        let currentPage = 1;
        const rowsPerPage = 15;
        let chartInstance = null;
        let currentFormat = 'ODI';

        document.addEventListener('DOMContentLoaded', () => {
            const payload = document.getElementById('data-payload');
            if (!payload) return;
            rawData = JSON.parse(payload.textContent);

            const toggle = document.getElementById('formatToggle');

            // Format Selection Listener
            toggle.addEventListener('change', () => {
                currentFormat = toggle.checked ? 'T20' : 'ODI';
                currentPage = 1; 
                updateView();
            });

            updateView();
        });

        /**
         * Syncs UI state based on current format
         */
        function updateView() {
            const labelOdi = document.getElementById('label-odi');
            const labelT20 = document.getElementById('label-t20');

            labelOdi.classList.toggle('active', currentFormat === 'ODI');
            labelT20.classList.toggle('active', currentFormat === 'T20');

            filteredData = rawData.filter(r => (r.format_name || '').trim() === currentFormat);

            renderChart(filteredData);
            renderTable();
        }

        /**
         * Handles table row generation and pagination logic
         */
        function renderTable() {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';

            const totalPages = Math.ceil(filteredData.length / rowsPerPage);
            const startIndex = (currentPage - 1) * rowsPerPage;
            const endIndex = startIndex + rowsPerPage;
            const pageData = filteredData.slice(startIndex, endIndex);

            // Update Pagination Text and Button States
            document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages || 1}`;
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages || totalPages === 0;

            pageData.forEach((row, index) => {
                const globalRank = startIndex + index + 1; 

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><div class="rank-circle" style="background:#334155;">${globalRank}</div></td>
                    <td>
                        <span class="format-badge ${row.format_name === 'ODI' ? 'format-odi' : 'format-t20'}">
                            ${row.format_name}
                        </span>
                    </td>
                    <td style="font-weight:600; color:#e2e8f0;">${row.venue_name}</td>
                    <td style="color:#94a3b8;">${row.venue_country}</td>
                    <td>${row.matches_played}</td>
                    <td><strong>${Number(row.avg_1st_innings_run).toFixed(0)}</strong></td>
                    <td><strong>${Number(row.avg_2nd_innings_run).toFixed(0)}</strong></td>
                `;
                tbody.appendChild(tr);
            });

            if (pageData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:30px; color:#64748b;">No data available for this format.</td></tr>`;
            }
        }

        /**
         * Navigation handler for pagination
         */
        function changePage(direction) {
            const totalPages = Math.ceil(filteredData.length / rowsPerPage);
            const newPage = currentPage + direction;

            if (newPage >= 1 && newPage <= totalPages) {
                currentPage = newPage;
                renderTable();
                // Smooth scroll back to table start for better UX
                document.querySelector('.results-card').scrollIntoView({ behavior: 'smooth' });
            }
        }

        /**
         * Renders the Scatter/Bubble Plot for Venue Analysis
         */
        function renderChart(data) {
            const ctx = document.getElementById('q10Chart');
            if (chartInstance) chartInstance.destroy();

            const scatterData = data.map(r => {
                const x = Number(r.avg_1st_innings_run) || 0;
                const y = Number(r.avg_2nd_innings_run) || 0;
                const count = Number(r.matches_played) || 1;
                const diff = x - y;

                // Color coding based on bias severity
                let color = '#00f2ff'; // Balanced
                if (diff > 25) color = '#ff3366'; 
                if (diff < -10) color = '#39ff14'; 
                
                return {
                    x,
                    y,
                    r: Math.max(5, Math.log2(count) * 5), 
                    venue: r.venue_name,
                    matches: count,
                    color: color
                };
            });

            chartInstance = new Chart(ctx.getContext('2d'), {
                type: 'bubble',
                data: {
                    datasets: [{
                        label: 'Venues',
                        data: scatterData,
                        backgroundColor: (c) => c.raw ? c.raw.color + '80' : '#fff',
                        borderColor: (c) => c.raw ? c.raw.color : '#fff',
                        borderWidth: 2,
                        hoverBackgroundColor: '#fff',
                        hoverRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            callbacks: {
                                label: (c) => [
                                    `🏟️ ${c.raw.venue}`,
                                    `Matches: ${c.raw.matches}`,
                                    `1st Inn: ${c.raw.x} | 2nd Inn: ${c.raw.y}`
                                ]
                            }
                        }
                    },
                    scales: {
                        x: {
                            title: { display: true, text: 'Avg 1st Innings Score', color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: '#cbd5e1' },
                            min: 100
                        },
                        y: {
                            title: { display: true, text: 'Avg 2nd Innings Score', color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: '#cbd5e1' },
                            min: 100
                        }
                    },
                    // CUSTOM PLUGIN: Diagonal Parity Line
                    plugins: [{
                        id: 'biasLine',
                        beforeDraw(chart) {
                            const { ctx, scales: { x, y } } = chart;
                            ctx.save();
                            ctx.beginPath();
                            const minVal = Math.min(x.min, y.min);
                            const maxVal = Math.max(x.max, y.max);

                            if (!x.getPixelForValue || !y.getPixelForValue) return;

                            const xStart = x.getPixelForValue(minVal);
                            const yStart = y.getPixelForValue(minVal);
                            const xEnd = x.getPixelForValue(maxVal);
                            const yEnd = y.getPixelForValue(maxVal);

                            if (xStart && yStart && xEnd && yEnd) {
                                ctx.moveTo(xStart, yStart);
                                ctx.lineTo(xEnd, yEnd);
                                ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
                                ctx.lineWidth = 2;
                                ctx.setLineDash([8, 8]);
                                ctx.stroke();
                            }
                            ctx.restore();
                        }
                    }]
                }
            });
        }
    </script>
</body>

</html>
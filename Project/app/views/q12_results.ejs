<%# 
    VIEW TEMPLATE: q12_results.ejs 
    -----------------------------------------------------------------------------
    Description: Top-Order Stability vs Win Rate Analysis.
    Features: 
    - Categorical Bubble Chart with random jittering to prevent data overlap.
    - Stability Bands: Low (<30%), Moderate (30-60%), and High (>60%).
    - Dynamic color coding and glow effects based on stability band.
    - Client-side pagination (15 rows per page) for team statistics.
    -----------------------------------------------------------------------------
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= queryTitle %></title>
    
    <link rel="stylesheet" href="../style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .pagination-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .page-btn {
            background: rgba(0, 242, 255, 0.1);
            border: 1px solid #00f2ff;
            color: #00f2ff;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .page-btn:hover:not(:disabled) {
            background: #00f2ff;
            color: #000;
        }

        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            border-color: #94a3b8;
            color: #94a3b8;
            background: transparent;
        }

        .page-info {
            color: #e2e8f0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <div class="content-wrapper">
        <header style="margin-bottom: 20px;">
            <h1>World Cup Cricket Analytics Hub</h1>
        </header>

        <div class="results-header-bar">
            <a href="../" class="back-button"><i class="fa-solid fa-arrow-left-long"></i> Back to Queries</a>
            <div class="header-text">
                <h2 class="results-title"><%= queryTitle %></h2>
                <p class="full-question"><%= fullQuestion %></p>
            </div>
        </div>

        <% if (locals.analystTake) { %>
            <div class="analyst-card">
                <div class="analyst-header">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Analyst's Take
                </div>
                <p class="analyst-text"><%= analystTake %></p>
            </div>
        <% } %>

        <div class="chart-section-card">
            <h3 class="chart-heading">Top Order Stability vs Win Rate</h3>
            <p style="color: #94a3b8; font-size: 0.9rem; text-align:center; margin-bottom: 20px;">
                <span style="color:#ef4444; text-shadow: 0 0 10px rgba(239, 68, 68, 0.5);">● Low Stability (&lt;30%)</span> |
                <span style="color:#eab308; text-shadow: 0 0 10px rgba(234, 179, 8, 0.5);">● Moderate (30–60%)</span> |
                <span style="color:#22c55e; text-shadow: 0 0 10px rgba(34, 197, 94, 0.5);">● High Stability (&gt;60%)</span>
                <br><br>
                <i>Higher = More Wins | Bigger Bubble = More Matches Played</i>
            </p>

            <div class="format-toggle-container">
                <div class="toggle-label active" id="label-odi">[ 🏏 ODI World Cup ]</div>
                <label class="switch">
                    <input type="checkbox" id="formatToggle">
                    <span class="slider round"></span>
                </label>
                <div class="toggle-label" id="label-t20">[ ⚡ T20 World Cup ]</div>
            </div>

            <div class="canvas-container" style="
                height: 550px; 
                position: relative;
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.1);
                box-shadow: 
                    0 0 30px rgba(34, 197, 94, 0.15),
                    0 0 20px rgba(234, 179, 8, 0.1),
                    inset 0 0 30px rgba(15, 23, 42, 0.8);
                padding: 20px;
                background: rgba(15, 23, 42, 0.6);
            ">
                <canvas id="q12Chart"></canvas>
            </div>
        </div>

        <main class="results-card" style="margin-top: 30px;">
            <div class="table-responsive">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Format</th>
                            <th>Team Name</th>
                            <th>Stability Band</th>
                            <th>Matches Played</th>
                            <th>Matches Won</th>
                            <th>Win Percentage</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>

            <div class="pagination-container" id="paginationControls">
                <button class="page-btn" id="prevBtn" onclick="changePage(-1)">Previous</button>
                <span class="page-info" id="pageInfo">Page 1 of 1</span>
                <button class="page-btn" id="nextBtn" onclick="changePage(1)">Next</button>
            </div>
        </main>
    </div>

    <script id="data-payload" type="application/json"><%- JSON.stringify(results || []) %></script>
    
    <script>
        /**
         * CLIENT-SIDE CONTROLLER: Q12 Analysis
         * Handles categorical scatter plotting and client-side table pagination.
         */
        let rawData = [];
        let filteredData = [];
        let currentPage = 1;
        const rowsPerPage = 15;
        let chartInstance = null;
        let currentFormat = 'ODI';

        document.addEventListener('DOMContentLoaded', () => {
            const payload = document.getElementById('data-payload');
            if(!payload) return;
            rawData = JSON.parse(payload.textContent);

            const toggle = document.getElementById('formatToggle');
            toggle.addEventListener('change', () => {
                currentFormat = toggle.checked ? 'T20' : 'ODI';
                currentPage = 1; 
                updateView();
            });

            updateView();
        });

        /**
         * Updates global view state
         */
        function updateView() {
            const labelOdi = document.getElementById('label-odi');
            const labelT20 = document.getElementById('label-t20');

            labelOdi.classList.toggle('active', currentFormat === 'ODI');
            labelT20.classList.toggle('active', currentFormat === 'T20');

            filteredData = rawData.filter(r => (r.format_name || '').trim() === currentFormat);

            renderChart(filteredData);
            renderTable();
        }

        /**
         * Renders the data table with pagination logic
         */
        function renderTable() {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';

            const totalPages = Math.ceil(filteredData.length / rowsPerPage);
            const startIndex = (currentPage - 1) * rowsPerPage;
            const endIndex = startIndex + rowsPerPage;
            const pageData = filteredData.slice(startIndex, endIndex);

            document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages || 1}`;
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages || totalPages === 0;

            pageData.forEach((row, index) => {
                const globalRank = startIndex + index + 1;
                
                // Band-specific UI styling
                let bandColor = '#fff';
                if(row.top_order_contribution_band.includes('Low')) bandColor = '#ef4444';
                if(row.top_order_contribution_band.includes('Moderate')) bandColor = '#eab308';
                if(row.top_order_contribution_band.includes('High')) bandColor = '#22c55e';

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><div class="rank-circle" style="background:#334155;">${globalRank}</div></td>
                    <td>
                        <span class="format-badge ${row.format_name === 'ODI' ? 'format-odi' : 'format-t20'}">
                            ${row.format_name}
                        </span>
                    </td>
                    <td style="font-weight:600; color:#e2e8f0;">${row.team_name}</td>
                    <td style="color:${bandColor}; font-weight:bold; text-shadow:0 0 10px ${bandColor}40;">
                        ${row.top_order_contribution_band}
                    </td>
                    <td>${row.matches_played}</td>
                    <td>${row.matches_won}</td>
                    <td><strong>${Number(row.win_percentage).toFixed(2)}%</strong></td>
                `;
                tbody.appendChild(tr);
            });

            if (pageData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:30px; color:#64748b;">No data available.</td></tr>`;
            }
        }

        /**
         * Navigation for pagination controls
         */
        function changePage(direction) {
            const totalPages = Math.ceil(filteredData.length / rowsPerPage);
            const newPage = currentPage + direction;

            if (newPage >= 1 && newPage <= totalPages) {
                currentPage = newPage;
                renderTable();
                document.querySelector('.results-card').scrollIntoView({ behavior: 'smooth' });
            }
        }

        /**
         * Renders categorical scatter chart with jitter
         */
        function renderChart(data) {
            const ctx = document.getElementById('q12Chart');
            if (chartInstance) chartInstance.destroy();

            const scatterData = data.map(r => {
                let xBase = 0;
                let color = '#fff';
                let borderColor = '#fff';

                // Assign categorical X position and aesthetic mapping
                if(r.top_order_contribution_band.includes('Low')) {
                    xBase = 1; 
                    color = 'rgba(239, 68, 68, 0.7)'; 
                    borderColor = '#ef4444';
                } else if(r.top_order_contribution_band.includes('Moderate')) {
                    xBase = 2; 
                    color = 'rgba(234, 179, 8, 0.7)'; 
                    borderColor = '#eab308';
                } else {
                    xBase = 3; 
                    color = 'rgba(34, 197, 94, 0.7)'; 
                    borderColor = '#22c55e';
                }

                // Apply jitter to spread points within their categorical column
                const jitter = (Math.random() - 0.5) * 0.6; 

                return {
                    x: xBase + jitter,
                    y: Number(r.win_percentage),
                    r: Math.max(6, Math.sqrt(Number(r.matches_played)) * 2), 
                    team: r.team_name,
                    band: r.top_order_contribution_band,
                    matches: r.matches_played,
                    bgColor: color,
                    bdColor: borderColor
                };
            });

            chartInstance = new Chart(ctx.getContext('2d'), {
                type: 'bubble',
                data: {
                    datasets: [{
                        label: 'Teams',
                        data: scatterData,
                        backgroundColor: (c) => c.raw ? c.raw.bgColor : '#fff',
                        borderColor: (c) => c.raw ? c.raw.bdColor : '#fff',
                        borderWidth: 2,
                        hoverBackgroundColor: '#fff',
                        hoverRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            type: 'linear',
                            min: 0.5,
                            max: 3.5,
                            grid: { display: false },
                            ticks: {
                                callback: (val) => {
                                    if(val === 1) return 'Low (<30%)';
                                    if(val === 2) return 'Moderate (30-60%)';
                                    if(val === 3) return 'High (>60%)';
                                    return '';
                                },
                                color: (ctx) => {
                                    if(ctx.tick.value === 1) return '#ef4444';
                                    if(ctx.tick.value === 2) return '#eab308';
                                    if(ctx.tick.value === 3) return '#22c55e';
                                    return '#fff';
                                },
                                font: { size: 14, weight: 'bold' }
                            },
                            title: { display: true, text: 'Top Order Contribution', color: '#94a3b8' }
                        },
                        y: {
                            min: 0,
                            max: 110,
                            title: { display: true, text: 'Win Percentage (%)', color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: '#cbd5e1' }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            titleColor: '#fff',
                            bodyColor: '#cbd5e1',
                            borderColor: 'rgba(255,255,255,0.2)',
                            borderWidth: 1,
                            padding: 12,
                            titleFont: { size: 14, weight: 'bold' },
                            callbacks: {
                                label: (c) => [
                                    `Team: ${c.raw.team}`,
                                    `Win Rate: ${c.raw.y.toFixed(1)}%`,
                                    `Matches: ${c.raw.matches}`
                                ]
                            }
                        }
                    }
                }
            });
        }
    </script>
</body>

</html>
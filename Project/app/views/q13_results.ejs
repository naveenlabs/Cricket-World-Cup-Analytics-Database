<%# 
    VIEW TEMPLATE: q13_results.ejs 
    -----------------------------------------------------------------------------
    Description: Extras Contribution Analysis (The Discipline Stack).
    Features: 
    - Stacked Bar Chart comparing specific types of extras across teams.
    - Format switching (ODI/T20) with synchronized data filtering.
    - Client-side pagination (15 rows per page) for team discipline stats.
    - Color-coded table columns for intuitive data mapping.
    -----------------------------------------------------------------------------
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= queryTitle %></title>
    
    <link rel="stylesheet" href="../style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .pagination-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .page-btn {
            background: rgba(0, 242, 255, 0.1);
            border: 1px solid #00f2ff;
            color: #00f2ff;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .page-btn:hover:not(:disabled) {
            background: #00f2ff;
            color: #000;
        }

        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            border-color: #94a3b8;
            color: #94a3b8;
            background: transparent;
        }

        .page-info {
            color: #e2e8f0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <div class="content-wrapper">
        <header style="margin-bottom: 20px;">
            <h1>World Cup Cricket Analytics Hub</h1>
        </header>

        <div class="results-header-bar">
            <a href="../" class="back-button"><i class="fa-solid fa-arrow-left-long"></i> Back to Queries</a>
            <div class="header-text">
                <h2 class="results-title"><%= queryTitle %></h2>
                <p class="full-question"><%= fullQuestion %></p>
            </div>
        </div>

        <% if (locals.analystTake) { %>
            <div class="analyst-card">
                <div class="analyst-header">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Analyst's Take
                </div>
                <p class="analyst-text"><%= analystTake %></p>
            </div>
        <% } %>

        <div class="chart-section-card">
            <h3 class="chart-heading">The Discipline Stack: Extras Breakdown</h3>
            <p style="color: #94a3b8; font-size: 0.9rem; text-align:center; margin-bottom: 20px; font-weight:600;">
                <span style="color:#F72585">● Wides</span> |
                <span style="color:#4CC9F0">● No Balls</span> |
                <span style="color:#7209B7">● Leg Byes</span> |
                <span style="color:#FFD60A">● Byes</span>
            </p>

            <div class="format-toggle-container">
                <div class="toggle-label active" id="label-odi">[ 🏏 ODI World Cup ]</div>
                <label class="switch">
                    <input type="checkbox" id="formatToggle">
                    <span class="slider round"></span>
                </label>
                <div class="toggle-label" id="label-t20">[ ⚡ T20 World Cup ]</div>
            </div>

            <div class="canvas-container" style="height: 500px; position: relative;">
                <canvas id="q13Chart"></canvas>
            </div>
        </div>

        <main class="results-card" style="margin-top: 30px;">
            <div class="table-responsive">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Format</th>
                            <th>Team</th>
                            <th>Matches</th>
                            <th style="color:#F72585;">Wides</th>
                            <th style="color:#4CC9F0;">No Balls</th>
                            <th style="color:#7209B7;">Leg Byes</th>
                            <th style="color:#FFD60A;">Byes</th>
                            <th>Total Extras</th>
                            <th>% of Runs</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>

            <div class="pagination-container" id="paginationControls">
                <button class="page-btn" id="prevBtn" onclick="changePage(-1)">Previous</button>
                <span class="page-info" id="pageInfo">Page 1 of 1</span>
                <button class="page-btn" id="nextBtn" onclick="changePage(1)">Next</button>
            </div>
        </main>
    </div>

    <script id="data-payload" type="application/json"><%- JSON.stringify(results || []) %></script>
    
    <script>
        /**
         * CLIENT-SIDE CONTROLLER: Q13 Extras Analysis
         * Handles dynamic stacked bar charting and paginated table views.
         */
        let rawData = [];
        let filteredData = [];
        let currentPage = 1;
        const rowsPerPage = 15;
        let chartInstance = null;
        let currentFormat = 'ODI';

        document.addEventListener('DOMContentLoaded', () => {
            const payload = document.getElementById('data-payload');
            if (!payload) return;
            rawData = JSON.parse(payload.textContent);

            const toggle = document.getElementById('formatToggle');

            // Format Toggle Listener
            toggle.addEventListener('change', () => {
                currentFormat = toggle.checked ? 'T20' : 'ODI';
                currentPage = 1; 
                updateView();
            });

            updateView();
        });

        /**
         * Updates all UI components when state changes
         */
        function updateView() {
            const labelOdi = document.getElementById('label-odi');
            const labelT20 = document.getElementById('label-t20');

            labelOdi.classList.toggle('active', currentFormat === 'ODI');
            labelT20.classList.toggle('active', currentFormat === 'T20');

            filteredData = rawData.filter(r => (r.format_name || '').trim() === currentFormat);

            renderChart(filteredData);
            renderTable();
        }

        /**
         * Renders the statistical table with pagination
         */
        function renderTable() {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';

            const totalPages = Math.ceil(filteredData.length / rowsPerPage);
            const startIndex = (currentPage - 1) * rowsPerPage;
            const endIndex = startIndex + rowsPerPage;
            const pageData = filteredData.slice(startIndex, endIndex);

            // Update Pagination Meta
            document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages || 1}`;
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages || totalPages === 0;

            pageData.forEach((row, index) => {
                const globalRank = startIndex + index + 1;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><div class="rank-circle" style="background:#334155;">${globalRank}</div></td>
                    <td>
                        <span class="format-badge ${row.format_name === 'ODI' ? 'format-odi' : 'format-t20'}">
                            ${row.format_name}
                        </span>
                    </td>
                    <td style="font-weight:600; color:#e2e8f0;">${row.team_name}</td>
                    <td>${row.matches_played}</td>
                    <td style="color:#F72585; font-weight:bold;">${row.wide_runs}</td>
                    <td style="color:#4CC9F0; font-weight:bold;">${row.no_ball_runs}</td>
                    <td style="color:#7209B7;">${row.leg_bye_runs}</td>
                    <td style="color:#FFD60A;">${row.bye_runs}</td>
                    <td><strong>${row.total_extras}</strong></td>
                    <td>${Number(row.extras_pct_of_team_runs).toFixed(2)}%</td>
                `;
                tbody.appendChild(tr);
            });

            if (pageData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="10" style="text-align:center; padding:30px; color:#64748b;">No data available.</td></tr>`;
            }
        }

        /**
         * Navigation logic for pagination
         */
        function changePage(direction) {
            const totalPages = Math.ceil(filteredData.length / rowsPerPage);
            const newPage = currentPage + direction;

            if (newPage >= 1 && newPage <= totalPages) {
                currentPage = newPage;
                renderTable();
                document.querySelector('.results-card').scrollIntoView({ behavior: 'smooth' });
            }
        }

        /**
         * Renders the Stacked Bar Chart for extras breakdown
         */
        function renderChart(data) {
            const ctx = document.getElementById('q13Chart');
            if (chartInstance) chartInstance.destroy();

            // Sort by total volume and display top 12 for visual clarity
            const chartData = [...data]
                .sort((a, b) => b.total_extras - a.total_extras)
                .slice(0, 12);

            chartInstance = new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: chartData.map(r => r.team_name),
                    datasets: [
                        {
                            label: 'Wides',
                            data: chartData.map(r => r.wide_runs),
                            backgroundColor: '#F72585', 
                            borderColor: '#F72585',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'No Balls',
                            data: chartData.map(r => r.no_ball_runs),
                            backgroundColor: '#4CC9F0', 
                            borderColor: '#4CC9F0',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Leg Byes',
                            data: chartData.map(r => r.leg_bye_runs),
                            backgroundColor: '#7209B7', 
                            borderColor: '#7209B7',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Byes',
                            data: chartData.map(r => r.bye_runs),
                            backgroundColor: '#FFD60A',
                            borderColor: '#FFD60A',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            stacked: true, 
                            ticks: { color: '#ffffff', font: { weight: 'bold' } },
                            grid: { display: false }
                        },
                        y: {
                            stacked: true, 
                            beginAtZero: true,
                            title: { display: true, text: 'Total Runs Given', color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: '#94a3b8' }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { color: '#cbd5e1', padding: 20, font: { size: 14 } }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            titleColor: '#fff',
                            bodyColor: '#cbd5e1',
                            borderColor: 'rgba(255,255,255,0.1)',
                            borderWidth: 1,
                            padding: 10,
                            callbacks: {
                                footer: (items) => {
                                    const index = items[0].dataIndex;
                                    const total = chartData[index].total_extras;
                                    const matches = chartData[index].matches_played;
                                    return `Total: ${total} runs (${matches} matches)`;
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>
</body>

</html>
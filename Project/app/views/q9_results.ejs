<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= queryTitle %> - Analytics Hub
    </title>
    <link rel="stylesheet" href="../style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <div class="content-wrapper">
        <header style="margin-bottom: 20px;">
            <h1>World Cup Cricket Analytics Hub</h1>
        </header>

        <div class="results-header-bar">
            <a href="../" class="back-button">
                <i class="fa-solid fa-arrow-left-long"></i> Back to Queries
            </a>
            <div class="header-text">
                <h2 class="results-title">
                    <%= queryTitle %>
                </h2>
                <p class="full-question">
                    <%= fullQuestion %>
                </p>
            </div>
        </div>

        <% if (locals.analystTake) { %>
            <div class="analyst-card">
                <div class="analyst-header">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Analyst's Take
                </div>
                <p class="analyst-text">
                    <%= analystTake %>
                </p>
            </div>
            <% } %>

                <div class="chart-section-card">
                    <h3 class="chart-heading">SCORING PROGRESSION: NEON HEARTBEAT</h3>

                    <div class="format-toggle-container" style="margin-bottom: 20px;">
                        <div class="toggle-label active" id="label-odi">[ 🏏 ODI ]</div>
                        <label class="switch">
                            <input type="checkbox" id="formatToggle">
                            <span class="slider round"></span>
                        </label>
                        <div class="toggle-label" id="label-t20">[ ⚡ T20 ]</div>
                    </div>

                    <div class="canvas-container"
                        style="height: 550px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; padding: 20px;">
                        <canvas id="q9Chart"></canvas>
                    </div>
                </div>

                <main class="results-card" style="margin-top: 30px; overflow: visible;">
                    <div class="table-responsive">
                        <table class="results-table">
                            <thead>
                                <tr>
                                    <th style="width:50px;">#</th>
                                    <% fields.forEach(field=> { %>
                                        <th>
                                            <%= field.name.toUpperCase().replace(/_/g,' ') %></th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
        </main>
    </div>

    <script id="data-results" type="application/json"><%- JSON.stringify(results || []) %></script>
    <script id="data-fields" type="application/json"><%- JSON.stringify(fields || []) %></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const rawResults =
                JSON.parse(document.getElementById('data-results').textContent);
            const tableFields =
                JSON.parse(document.getElementById('data-fields').textContent);
            const formatToggle = document.getElementById('formatToggle');
            const tbody = document.getElementById('tableBody');
            const labelOdi = document.getElementById('label-odi');
            const labelT20 = document.getElementById('label-t20');

            let chartInstance = null;

            // 🎨 VIBRANT NEON TEAM PALETTE
            const teamColors = {
                'India': '#00f2ff', // Electric Cyan
                'Australia': '#fbbf24', // Neon Gold
                'England': '#ff3333', // Bright Red
                'South Africa': '#39ff14', // Neon Green
                'New Zealand': '#ffffff', // Pure White Light
                'Pakistan': '#22c55e', // Jungle Green
                'West Indies': '#d946ef', // Magenta
                'Sri Lanka': '#3b82f6' // Electric Blue
            };

            function updateView() {
                const isT20 = formatToggle.checked;
                const format = isT20 ? 'T20' : 'ODI';

                labelOdi.classList.toggle('active', !isT20);
                labelT20.classList.toggle('active', isT20);

                const filteredData = rawResults.filter(r => (r.format_name || '').trim()
                    === format);

                // 1. RENDER TABLE
                tbody.innerHTML = '';
                filteredData.forEach((row, i) => {
                    const tr = document.createElement('tr');
                    let rank = `<div class="rank-circle"
                                                    style="background:rgba(255,255,255,0.05); border:1px solid #333; color:#666;">
                                                    ${i + 1}</div>`;

                    let html = `
                                        <td>${rank}</td>`;
                    tableFields.forEach(f => {
                        let v = row[f.name];
                        if (f.name === 'format_name') {
                            v = `<span
                                            class="format-badge ${v === 'ODI' ? 'format-odi' : 'format-t20'}">${v}</span>`;
                        } else if (f.name === 'team_name') {
                            const color = teamColors[v] || '#94a3b8';
                            // Text glow in table
                            v = `<span
                                            style="color:${color}; font-weight:900; text-shadow: 0 0 8px ${color}66;">${v}</span>`;
                        } else if (!isNaN(v) && v !== null && v !== '' && v % 1 !== 0) {
                            v = `<strong>${Number(v).toFixed(2)}</strong>`;
                        }
                        html += `<td>${v ?? '-'}</td>`;
                    });
                    tr.innerHTML = html;
                    tbody.appendChild(tr);
                });

                // 2. RENDER MULTI-LINE CHART
                const ctx = document.getElementById('q9Chart').getContext('2d');
                if (chartInstance) chartInstance.destroy();

                const phases = ['Powerplay', 'Middle Overs', 'Death Overs'];
                const teams = [...new Set(filteredData.map(r => r.team_name))];

                const datasets = teams.map(team => {
                    const color = teamColors[team] || '#94a3b8';

                    const dataPoints = phases.map(phase => {
                        const entry = filteredData.find(r => r.team_name === team && r.match_phase ===
                            phase);
                        return entry ? Number(entry.run_rate) : null;
                    });

                    return {
                        label: team,
                        data: dataPoints,
                        borderColor: color,
                        backgroundColor: color,
                        borderWidth: 3,
                        tension: 0.4, // Smooth curves
                        // Point Styles (Hollow centers for tech look)
                        pointBackgroundColor: '#1a1a1a',
                        pointBorderColor: color,
                        pointBorderWidth: 2,
                        pointRadius: 6,
                        // Hover Styles (Bright flash)
                        pointHoverRadius: 10,
                        pointHoverBackgroundColor: '#ffffff',
                        pointHoverBorderColor: color,
                        pointHoverBorderWidth: 4
                    };
                });

                chartInstance = new Chart(ctx, {
                    type: 'line',
                    data: { labels: phases, datasets: datasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        animation: { duration: 1500, easing: 'easeOutQuart' },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    color: '#cbd5e1', font: { size: 12, weight: 'bold' }, usePointStyle:
                                        true, padding: 20
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0,0,0,0.95)',
                                titleColor: '#fff',
                                titleFont: { size: 14, weight: 'bold' },
                                bodyFont: { size: 13, weight: 'bold' },
                                borderColor: 'rgba(255,255,255,0.2)',
                                borderWidth: 1,
                                padding: 15,
                                boxPadding: 6,
                                usePointStyle: true,
                                callbacks: {
                                    label: (ctx) => ` ${ctx.dataset.label}: ${ctx.raw.toFixed(2)} RR`
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(255,255,255,0.02)' },
                                ticks: { color: '#fff', font: { size: 14, weight: '900' }, padding: 10 }
                            },
                            y: {
                                beginAtZero: false,
                                grid: { color: 'rgba(255,255,255,0.05)', borderDash: [5, 5] },
                                ticks: { color: '#94a3b8', font: { weight: 'bold' }, callback: v => v + ' rpo' },
                                title: {
                                    display: true, text: 'RUNS PER OVER', color: '#64748b',
                                    font: { weight: 'bold' }
                                }
                            }
                        }
                    },
                    // THE NEON GLOW PLUGIN
                    plugins: [{
                        id: 'neonLineGlow',
                        beforeDatasetDraw(chart, args) {
                            const { ctx } = chart;
                            const dataset = chart.data.datasets[args.index];
                            ctx.save();
                            // Set shadow color specifically to the line's color
                            ctx.shadowColor = dataset.borderColor;
                            // High blur for intense neon effect
                            ctx.shadowBlur = 10;
                            ctx.shadowOffsetX = 0;
                            ctx.shadowOffsetY = 0;
                        },
                        afterDatasetDraw(chart, args) {
                            chart.ctx.restore();
                        }
                    }]
                });
            }

            formatToggle.addEventListener('change', updateView);
            updateView();
        });
    </script>
</body>

</html>